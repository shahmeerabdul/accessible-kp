DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Comma-separated list of allowed CORS origins for the frontend.
# For local dev with Vite React:
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Overpass API endpoint. overpass-api.de (the "official" default most docs
# point to) is frequently overloaded and slow/504s under real-world load;
# OSM France's mirror has been noticeably more reliable, so it's the default
# here. Swap to another mirror (e.g. overpass-api.de, overpass.kumi.systems)
# if this one is having issues.
OVERPASS_API_URL=https://overpass.openstreetmap.fr/api/interpreter

# Overpass rejects requests with a generic/default User-Agent (406). Set this
# to something identifying your app/contact if you fork or self-host this.
OVERPASS_USER_AGENT=AccessibleKPK/1.0 (+https://github.com/shahmeerabdul/accessible-kp)

# Radius in meters searched around each city's center point
CITY_SEARCH_RADIUS_METERS=12000

# Facilities cache TTL in seconds (e.g. 600 = 10 minutes)
FACILITIES_CACHE_TTL=600

