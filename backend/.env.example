# Local development settings. DEBUG is OFF by default, so keep DJANGO_DEBUG=true
# here for local use only.
#
# PRODUCTION: set DJANGO_DEBUG=false (or remove it), a unique random
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS=your.api.domain (no "*") and
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain. The app refuses to start
# outside DEBUG if any of these are missing or still placeholders.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*

# Comma-separated list of allowed CORS origins for the frontend.
# Optional in local dev (all origins are allowed when DJANGO_DEBUG=true);
# required otherwise. For local dev with Vite React:
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Per-client rate limit for the API (DRF format: N/second|minute|hour|day).
API_THROTTLE_RATE=60/min
# Behind nginx / a load balancer, set the number of proxies in front of Django
# so the limit sees the real client IP instead of the proxy's.
# API_NUM_PROXIES=1

# Shared cache (Redis / ElastiCache). Leave unset to use per-process memory.
# REDIS_URL=redis://localhost:6379/0

# Log level: DEBUG, INFO (default), WARNING, ERROR.
# LOG_LEVEL=INFO

# Production only (DJANGO_DEBUG=false) -- see deploy/README.md:
# DJANGO_SECURE_SSL_REDIRECT=true   # redirect HTTP to HTTPS
# DJANGO_BEHIND_PROXY=true          # trust X-Forwarded-Proto from nginx / an ALB
# DJANGO_HSTS_SECONDS=3600          # raise to 31536000 once HTTPS works everywhere

# Which upstream to pull facility data from: "healthsites" or "overpass".
FACILITIES_PROVIDER=healthsites

# healthsites.io API key (required when FACILITIES_PROVIDER=healthsites).
# Get one free: https://healthsites.io/ -> sign in with an OpenStreetMap
# account -> profile page -> generate key. Never commit your real key.
HEALTHSITES_API_KEY=YOUR_API_KEY

# Overpass API endpoint. overpass-api.de (the "official" default most docs
# point to) is frequently overloaded and slow/504s under real-world load;
# OSM France's mirror has been noticeably more reliable, so it's the default
# here. Swap to another mirror (e.g. overpass-api.de, overpass.kumi.systems)
# if this one is having issues.
OVERPASS_API_URL=https://overpass.openstreetmap.fr/api/interpreter

# Overpass rejects requests with a generic/default User-Agent (406). Set this
# to something identifying your app/contact if you fork or self-host this.
OVERPASS_USER_AGENT=AccessibleKPK/1.0 (+https://github.com/shahmeerabdul/accessible-kp)

# Radius in meters searched around each city's center point
CITY_SEARCH_RADIUS_METERS=12000

# Facilities cache TTL in seconds (e.g. 600 = 10 minutes)
FACILITIES_CACHE_TTL=600

